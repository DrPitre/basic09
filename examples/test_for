// test_for.b09

DIM I:INTEGER
DIM S:INTEGER

// basic count
S = 0
FOR I = 1 TO 3
  S = S + I
NEXT I
IF S = 6 THEN PRINT "PASS: basic count"
IF S <> 6 THEN PRINT "FAIL: basic count"

// step 2
S = 0
FOR I = 1 TO 9 STEP 2
  S = S + 1
NEXT I
IF S = 5 THEN PRINT "PASS: step 2"
IF S <> 5 THEN PRINT "FAIL: step 2"

// negative step
S = 0
FOR I = 3 TO 1 STEP -1
  S = S + 1
NEXT I
IF S = 3 THEN PRINT "PASS: negative step"
IF S <> 3 THEN PRINT "FAIL: negative step"

// empty range
S = 0
FOR I = 5 TO 1
  S = S + 1
NEXT I
IF S = 0 THEN PRINT "PASS: empty range"
IF S <> 0 THEN PRINT "FAIL: empty range"

// accumulator 1..10
S = 0
FOR I = 1 TO 10
  S = S + I
NEXT I
IF S = 55 THEN PRINT "PASS: accumulator"
IF S <> 55 THEN PRINT "FAIL: accumulator"
