// test_procedures.b09

DIM X:INTEGER

// simple procedure call
RUN GREET

// procedure with args
RUN DOUBLE(7)

// scope isolation: outer X should stay 0 after SETX modifies its own local X
X = 0
RUN SETX
IF X = 0 THEN PRINT "PASS: scope isolation"
IF X <> 0 THEN PRINT "FAIL: scope isolation"

// RETURN exits early
RUN EARLY(FALSE)

PROCEDURE GREET
  PRINT "PASS: simple procedure"
END

PROCEDURE DOUBLE(N:INTEGER)
  IF N * 2 = 14 THEN PRINT "PASS: procedure with args"
  IF N * 2 <> 14 THEN PRINT "FAIL: procedure with args"
END

PROCEDURE SETX
  DIM X:INTEGER
  X = 99
END

PROCEDURE EARLY(B:BOOLEAN)
  IF B THEN
    RETURN
  ENIF
  PRINT "PASS: procedure return"
END
