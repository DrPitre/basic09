  PRINT "FAIL: if false should not print"
ENIF

IF 1 = 1 THEN
  PRINT "PASS: if/else true branch"
ELSE
  PRINT "FAIL: if/else true branch"
ENIF

IF 1 = 2 THEN
  PRINT "FAIL: if/else false branch"
ELSE
