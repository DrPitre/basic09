// exit_while.b09 - EXIT IF from WHILE and REPEAT

DIM I:INTEGER

// Test 1: EXIT IF from WHILE
I = 0
WHILE TRUE
  I = I + 1
  EXIT IF I = 7
ENDWHILE
IF I = 7 THEN
  PRINT "PASS: EXIT IF from WHILE"
ELSE
  PRINT "FAIL: EXIT IF from WHILE, I=" + STR$(I)
ENIF

// Test 2: EXIT IF from REPEAT/UNTIL
I = 0
REPEAT
  I = I + 1
  EXIT IF I = 2
UNTIL FALSE
IF I = 2 THEN
  PRINT "PASS: EXIT IF from REPEAT"
ELSE
  PRINT "FAIL: EXIT IF from REPEAT, I=" + STR$(I)
ENIF
