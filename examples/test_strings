// test_strings.b09

DIM S:STRING
DIM OK:BOOLEAN

S = "Hello" + ", " + "World!"
IF S = "Hello, World!" THEN PRINT "PASS: concat"
IF S <> "Hello, World!" THEN PRINT "FAIL: concat"

IF LEN("hello") = 5 THEN PRINT "PASS: LEN"
IF LEN("hello") <> 5 THEN PRINT "FAIL: LEN"

IF LEFT$("hello", 3) = "hel" THEN PRINT "PASS: LEFT$"
IF LEFT$("hello", 3) <> "hel" THEN PRINT "FAIL: LEFT$"

IF RIGHT$("hello", 3) = "llo" THEN PRINT "PASS: RIGHT$"
IF RIGHT$("hello", 3) <> "llo" THEN PRINT "FAIL: RIGHT$"

IF MID$("hello", 2, 3) = "ell" THEN PRINT "PASS: MID$"
IF MID$("hello", 2, 3) <> "ell" THEN PRINT "FAIL: MID$"

IF UPPER$("hello") = "HELLO" THEN PRINT "PASS: UPPER$"
IF UPPER$("hello") <> "HELLO" THEN PRINT "FAIL: UPPER$"

IF LOWER$("HELLO") = "hello" THEN PRINT "PASS: LOWER$"
IF LOWER$("HELLO") <> "hello" THEN PRINT "FAIL: LOWER$"

IF ASC("A") = 65 THEN PRINT "PASS: ASC"
IF ASC("A") <> 65 THEN PRINT "FAIL: ASC"

IF CHR$(65) = "A" THEN PRINT "PASS: CHR$"
IF CHR$(65) <> "A" THEN PRINT "FAIL: CHR$"
