// test_arithmetic.b09

DIM OK:BOOLEAN

OK = (3 + 4 = 7)
IF OK THEN PRINT "PASS: add"
IF NOT OK THEN PRINT "FAIL: add"

OK = (10 - 3 = 7)
IF OK THEN PRINT "PASS: sub"
IF NOT OK THEN PRINT "FAIL: sub"

OK = (3 * 4 = 12)
IF OK THEN PRINT "PASS: mul"
IF NOT OK THEN PRINT "FAIL: mul"

OK = (7 / 2 = 3.5)
IF OK THEN PRINT "PASS: div"
IF NOT OK THEN PRINT "FAIL: div"

OK = (7 \ 2 = 3)
IF OK THEN PRINT "PASS: idiv"
IF NOT OK THEN PRINT "FAIL: idiv"

OK = (10 MOD 3 = 1)
IF OK THEN PRINT "PASS: mod"
IF NOT OK THEN PRINT "FAIL: mod"

OK = (2 ^ 8 = 256)
IF OK THEN PRINT "PASS: power"
IF NOT OK THEN PRINT "FAIL: power"

OK = (-5 = 0 - 5)
IF OK THEN PRINT "PASS: negation"
IF NOT OK THEN PRINT "FAIL: negation"

OK = ((2 + 3) * 4 = 20)
IF OK THEN PRINT "PASS: parens"
IF NOT OK THEN PRINT "FAIL: parens"

OK = (2 + 3 * 4 = 14)
IF OK THEN PRINT "PASS: precedence"
IF NOT OK THEN PRINT "FAIL: precedence"
