// test_data.b09

DIM X:INTEGER
DIM S:STRING

DATA 10, 20, 30
READ X
IF X = 10 THEN PRINT "PASS: read first"
IF X <> 10 THEN PRINT "FAIL: read first"

READ X
IF X = 20 THEN PRINT "PASS: read second"
IF X <> 20 THEN PRINT "FAIL: read second"

RESTORE
READ X
IF X = 10 THEN PRINT "PASS: restore"
IF X <> 10 THEN PRINT "FAIL: restore"

DATA "hello"
READ S
IF S = "hello" THEN PRINT "PASS: read string"
IF S <> "hello" THEN PRINT "FAIL: read string"
