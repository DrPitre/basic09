// test_arrays.b09

DIM A(5):INTEGER
DIM M(3,3):INTEGER

A(1) = 10
A(2) = 20

IF A(1) = 10 THEN PRINT "PASS: array set/get 1"
IF A(1) <> 10 THEN PRINT "FAIL: array set/get 1"

IF A(2) = 20 THEN PRINT "PASS: array set/get 2"
IF A(2) <> 20 THEN PRINT "FAIL: array set/get 2"

IF A(3) = 0 THEN PRINT "PASS: array default zero"
IF A(3) <> 0 THEN PRINT "FAIL: array default zero"

M(1,1) = 7
IF M(1,1) = 7 THEN PRINT "PASS: 2d array set/get"
IF M(1,1) <> 7 THEN PRINT "FAIL: 2d array set/get"

IF M(1,2) = 0 THEN PRINT "PASS: 2d array default zero"
IF M(1,2) <> 0 THEN PRINT "FAIL: 2d array default zero"
