// test_loops.b09

DIM I:INTEGER

// WHILE basic
I = 1
WHILE I <= 3
  I = I + 1
ENDWHILE
IF I = 4 THEN PRINT "PASS: while basic"
IF I <> 4 THEN PRINT "FAIL: while basic"

// WHILE false on entry
I = 10
WHILE I < 5
  I = I + 1
ENDWHILE
IF I = 10 THEN PRINT "PASS: while false entry"
IF I <> 10 THEN PRINT "FAIL: while false entry"

// REPEAT basic
I = 1
REPEAT
  I = I + 1
UNTIL I > 3
IF I = 4 THEN PRINT "PASS: repeat basic"
IF I <> 4 THEN PRINT "FAIL: repeat basic"

// REPEAT executes at least once
I = 99
REPEAT
  I = I + 1
UNTIL TRUE
IF I = 100 THEN PRINT "PASS: repeat once"
IF I <> 100 THEN PRINT "FAIL: repeat once"

// LOOP EXIT
I = 0
LOOP
  I = I + 1
  EXIT IF I = 3
ENDLOOP
IF I = 3 THEN PRINT "PASS: loop exit if"
IF I <> 3 THEN PRINT "FAIL: loop exit if"
