// exit_loop.b09 - EXIT and EXIT IF from LOOP/ENDLOOP

DIM I:INTEGER

// Test 1: unconditional EXIT
I = 0
LOOP
  I = I + 1
  IF I = 3 THEN
    EXIT
  ENIF
ENDLOOP
IF I = 3 THEN
  PRINT "PASS: EXIT from LOOP"
ELSE
  PRINT "FAIL: EXIT from LOOP, I=" + STR$(I)
ENIF

// Test 2: EXIT IF
I = 0
LOOP
  I = I + 1
  EXIT IF I = 5
ENDLOOP
IF I = 5 THEN
  PRINT "PASS: EXIT IF from LOOP"
ELSE
  PRINT "FAIL: EXIT IF from LOOP, I=" + STR$(I)
ENIF
